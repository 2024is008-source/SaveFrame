# NOT DEPLOYED. Use instead of saveframe.conf after review, never load both.
# Requires a valid certificate for both hostnames and a working upstream.
# Rate-limiting zones for SaveFrame API protection
include /etc/nginx/snippets/saveframe-analytics-region.conf;
limit_req_zone $binary_remote_addr zone=resolve_limit:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=download_limit:10m rate=15r/m;

upstream saveframe_backend {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name saveframe.site www.saveframe.site;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 308 https://saveframe.site$request_uri; }
}
server {
    listen 443 ssl;
    server_name www.saveframe.site;
    ssl_certificate /etc/letsencrypt/live/saveframe.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/saveframe.site/privkey.pem;
    return 308 https://saveframe.site$request_uri;
}
server {
    listen 443 ssl;
    server_name saveframe.site;
    ssl_certificate /etc/letsencrypt/live/saveframe.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/saveframe.site/privkey.pem;

    # Security Headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    client_max_body_size 64k;

    # Health check endpoint
    location = /api/health {
        proxy_pass http://saveframe_backend;
        proxy_set_header Host $host;
        proxy_set_header X-SaveFrame-Country $saveframe_analytics_country;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    # Media Resolution Endpoint
    location = /api/media/resolve {
        limit_req zone=resolve_limit burst=10 nodelay;
        proxy_pass http://saveframe_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-SaveFrame-Country $saveframe_analytics_country;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 75s;
    }

    # Media Download Job Creation & Stream Delivery
    location /api/media/download {
        limit_req zone=download_limit burst=5 nodelay;
        proxy_pass http://saveframe_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-SaveFrame-Country $saveframe_analytics_country;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
    }

    # Job Polling & Cancellation
    location /api/media/jobs {
        proxy_pass http://saveframe_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-SaveFrame-Country $saveframe_analytics_country;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Frontend Application
    location / {
        proxy_pass http://saveframe_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-SaveFrame-Country $saveframe_analytics_country;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
