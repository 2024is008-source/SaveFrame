{
  "markup": "\n\n  <!-- Skip to Main Content for Keyboard Accessibility -->\n  <a href=\"#main-tool\" class=\"sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-brand-violet focus:text-white focus:px-4 focus:py-2.5 focus:rounded-lg focus:text-sm focus:font-medium\">\n    Skip to TikTok Downloader tool\n  </a>\n\n  <!-- HEADER -->\n  <header class=\"sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-line\">\n    <div class=\"max-w-[1120px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3\">\n      \n      <!-- Brand Logo -->\n      <div class=\"flex items-center gap-2.5\">\n        <button type=\"button\" id=\"brand-home-btn\" class=\"group flex items-center gap-2.5 text-left py-1.5 rounded-lg cursor-pointer\" aria-label=\"TikSaveMP4 TikTok Downloader Home\">\n          <span class=\"w-9 h-9 rounded-xl flex items-center justify-center border border-line bg-soft group-hover:border-brand-violet/40 ui-transition shrink-0\">\n            <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n              <path d=\"M14 3v12a4 4 0 1 1-4-4\" stroke=\"#25F4EE\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M14 3c0 4 3 6 6 6\" stroke=\"#FE2C55\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n            </svg>\n          </span>\n          <div>\n            <span class=\"font-display font-bold text-lg tracking-tight text-ink block leading-none\">TikSaveMP4</span>\n            <span class=\"text-[11px] text-ink-muted font-medium block mt-0.5\">TikTok Media Utility</span>\n          </div>\n        </button>\n      </div>\n\n      <!-- Desktop Navigation -->\n      <nav class=\"hidden md:flex items-center gap-1 lg:gap-2\" aria-label=\"Primary Navigation\">\n        \n        <!-- TikTok Downloader Dropdown -->\n        <div class=\"relative\" id=\"nav-downloader-wrap\">\n          <button\n            type=\"button\"\n            id=\"nav-downloader-btn\"\n            aria-expanded=\"false\"\n            aria-controls=\"nav-downloader-menu\"\n            class=\"min-h-[44px] px-3.5 py-2 rounded-lg text-sm font-medium text-ink-secondary hover:text-ink hover:bg-soft flex items-center gap-1.5 cursor-pointer ui-transition\"\n          >\n            <span data-i18n=\"navDownloader\">TikTok Downloader</span>\n            <svg class=\"w-4 h-4 text-ink-muted ui-transition\" id=\"nav-downloader-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </button>\n          <div\n            id=\"nav-downloader-menu\"\n            role=\"menu\"\n            class=\"hidden absolute left-0 mt-1.5 w-64 bg-white border border-line rounded-xl shadow-lg p-1.5 z-50\"\n          >\n            <button type=\"button\" data-route-tab=\"photo\" class=\"w-full flex items-start gap-3 p-2.5 rounded-lg hover:bg-soft text-left cursor-pointer ui-transition\">\n              <span class=\"w-8 h-8 rounded-lg bg-brand-violetSoft text-brand-violet flex items-center justify-center shrink-0 mt-0.5\">\n                <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"/><circle cx=\"9\" cy=\"9\" r=\"2\"/><path d=\"m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21\"/></svg>\n              </span>\n              <span>\n                <span class=\"block text-sm font-semibold text-ink\">Photo Downloader</span>\n                <span class=\"block text-xs text-ink-muted\">Single photos &amp; multi-slide carousels</span>\n              </span>\n            </button>\n            \n            <button type=\"button\" data-route-tab=\"video\" class=\"w-full flex items-start gap-3 p-2.5 rounded-lg hover:bg-soft text-left cursor-pointer ui-transition\">\n              <span class=\"w-8 h-8 rounded-lg bg-brand-orangeSoft text-brand-orange flex items-center justify-center shrink-0 mt-0.5\">\n                <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg>\n              </span>\n              <span>\n                <span class=\"block text-sm font-semibold text-ink\">Video Downloader</span>\n                <span class=\"block text-xs text-ink-muted\">Public TikTok videos as MP4</span>\n              </span>\n            </button>\n            \n          </div>\n        </div>\n\n        <!-- Photo Slideshows Dropdown -->\n        <div class=\"relative\" id=\"nav-viewer-wrap\">\n          <button\n            type=\"button\"\n            id=\"nav-viewer-btn\"\n            aria-expanded=\"false\"\n            aria-controls=\"nav-viewer-menu\"\n            class=\"min-h-[44px] px-3.5 py-2 rounded-lg text-sm font-medium text-ink-secondary hover:text-ink hover:bg-soft flex items-center gap-1.5 cursor-pointer ui-transition\"\n          >\n            <span data-i18n=\"navViewer\">Photo Slideshows</span>\n            <svg class=\"w-4 h-4 text-ink-muted ui-transition\" id=\"nav-viewer-chevron\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m6 9 6 6 6-6\" />\n            </svg>\n          </button>\n          <div\n            id=\"nav-viewer-menu\"\n            role=\"menu\"\n            class=\"hidden absolute left-0 mt-1.5 w-64 bg-white border border-line rounded-xl shadow-lg p-1.5 z-50\"\n          >\n            \n            \n            <button type=\"button\" id=\"nav-carousel-inspector-btn\" class=\"w-full flex items-start gap-3 p-2.5 rounded-lg hover:bg-soft text-left cursor-pointer ui-transition\">\n              <span class=\"w-8 h-8 rounded-lg bg-brand-orangeSoft text-brand-orange flex items-center justify-center shrink-0 mt-0.5\">\n                <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\"/><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"/></svg>\n              </span>\n              <span>\n                <span class=\"block text-sm font-semibold text-ink\">Carousel Post Viewer</span>\n                <span class=\"block text-xs text-ink-muted\">Preview multi-slide album posts</span>\n              </span>\n            </button>\n          </div>\n        </div>\n\n        <!-- How to Use Link -->\n        <a href=\"#how-to-use\" class=\"min-h-[44px] px-3.5 py-2 rounded-lg text-sm font-medium text-ink-secondary hover:text-ink hover:bg-soft flex items-center ui-transition\" data-i18n=\"navHowTo\">\n          How to Use\n        </a>\n\n        <!-- FAQ Link -->\n        <a href=\"#faq-section\" class=\"min-h-[44px] px-3.5 py-2 rounded-lg text-sm font-medium text-ink-secondary hover:text-ink hover:bg-soft flex items-center ui-transition\">\n          FAQ\n        </a><a  href=\"/blog\" class=\"min-h-[44px] px-3.5 py-2 rounded-lg text-sm font-medium text-ink-secondary hover:text-ink hover:bg-soft flex items-center ui-transition\">Blog Guides</a>\n\n        <!-- Blog Link -->\n        \n      </nav>\n\n      <!-- Right Controls: Language Selector & Mobile Menu Button -->\n      <div class=\"flex items-center gap-2\">\n        \n\n        <!-- Mobile Menu Toggle -->\n        <button\n          type=\"button\"\n          id=\"mobile-menu-btn\"\n          aria-expanded=\"false\"\n          aria-controls=\"mobile-nav-drawer\"\n          aria-label=\"Toggle navigation menu\"\n          class=\"md:hidden w-11 h-11 rounded-lg border border-line bg-white hover:bg-soft flex items-center justify-center text-ink cursor-pointer ui-transition\"\n        >\n          <svg id=\"mobile-menu-icon-open\" class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 7h16M4 12h16M4 17h16\" />\n          </svg>\n          <svg id=\"mobile-menu-icon-close\" class=\"w-5 h-5 hidden\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\" />\n          </svg>\n        </button>\n      </div>\n    </div>\n\n    <!-- Mobile Navigation Drawer -->\n    <div id=\"mobile-nav-drawer\" class=\"hidden md:hidden border-t border-line bg-white px-4 pt-3 pb-5\">\n      <div class=\"space-y-4\">\n        <div>\n          <p class=\"text-xs font-semibold text-ink-muted px-2 mb-1.5\">TikTok Downloader Tools</p>\n          <div class=\"grid grid-cols-2 gap-1.5\">\n            <button type=\"button\" data-route-tab=\"photo\" class=\"min-h-[44px] px-3 py-2 rounded-lg border border-line bg-soft/50 hover:bg-soft text-left text-sm font-medium text-ink flex items-center gap-2 cursor-pointer\">\n              <span class=\"w-2 h-2 rounded-full bg-brand-violet\"></span> Photo\n            </button>\n            \n            <button type=\"button\" data-route-tab=\"video\" class=\"min-h-[44px] px-3 py-2 rounded-lg border border-line bg-soft/50 hover:bg-soft text-left text-sm font-medium text-ink flex items-center gap-2 cursor-pointer\">\n              <span class=\"w-2 h-2 rounded-full bg-brand-orange\"></span> Video\n            </button>\n            \n          </div>\n        </div>\n        <div>\n          <p class=\"text-xs font-semibold text-ink-muted px-2 mb-1.5\">Photo Slideshows &amp; Guides</p>\n          <div class=\"flex flex-col gap-1\">\n            \n            <a href=\"/photo-downloader\" data-route-tab=\"carousel\" class=\"min-h-[44px] px-3 py-2 rounded-lg hover:bg-soft text-left text-sm font-medium text-ink flex items-center justify-between cursor-pointer\"><span>TikTok Carousel Downloader</span><span class=\"text-xs text-brand-violet font-medium\">Open tool \u2192</span></a>\n            <a href=\"#how-to-use\" class=\"mobile-nav-link min-h-[44px] px-3 py-2 rounded-lg hover:bg-soft text-sm font-medium text-ink-secondary flex items-center\">How to Use</a>\n            <a href=\"#features-section\" class=\"mobile-nav-link min-h-[44px] px-3 py-2 rounded-lg hover:bg-soft text-sm font-medium text-ink-secondary flex items-center\">Supported Formats &amp; Features</a>\n            <a href=\"#faq-section\" class=\"mobile-nav-link min-h-[44px] px-3 py-2 rounded-lg hover:bg-soft text-sm font-medium text-ink-secondary flex items-center\">Frequently Asked Questions</a><a  href=\"/blog\" class=\"mobile-nav-link min-h-[44px] px-3 py-2 rounded-lg hover:bg-soft text-sm font-medium text-ink-secondary flex items-center\">Blog Guides</a>\n            \n          </div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <!-- MAIN CONTENT -->\n  <main id=\"main-tool\" class=\"flex-1\">\n    \n    <!-- HERO + MAIN DOWNLOADER SECTION -->\n    <section class=\"pt-6 pb-12 sm:pt-10 sm:pb-16 px-4 sm:px-6\">\n      <div class=\"max-w-[840px] mx-auto\">\n        \n        <!-- Centered Hero Heading & Description (2-line max compliance at all viewports) -->\n        <div class=\"text-center max-w-[640px] mx-auto mb-6 sm:mb-8\">\n          <h1 id=\"hero-heading\" class=\"font-display font-bold text-[26px] sm:text-4xl lg:text-[42px] text-ink leading-[1.15] tracking-tight\">Download TikTok Videos &amp; Photos</h1>\n          <p id=\"hero-description\" class=\"mt-2.5 sm:mt-3 text-sm sm:text-base text-ink-muted leading-relaxed\">\n            Save supported TikTok videos and photo slideshows with a simple link.\n          </p>\n        </div>\n\n        <!-- 5 SELECTABLE MEDIA TOOL TABS -->\n        <div\n          role=\"tablist\"\n          aria-label=\"TikTok Media Tool Categories\"\n          class=\"grid grid-cols-2 gap-1 sm:gap-2 p-1.5 bg-soft border border-line rounded-2xl mb-4 sm:mb-5\"\n        >\n          <!-- 1. Photo -->\n          <button\n            type=\"button\"\n            role=\"tab\"\n            id=\"tab-photo\"\n            aria-selected=\"true\"\n            aria-controls=\"downloader-panel\"\n            data-tab=\"photo\"\n            class=\"media-tab-btn min-h-[52px] sm:min-h-[48px] px-1.5 sm:px-3 py-2 rounded-xl flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 text-xs sm:text-sm font-semibold cursor-pointer ui-transition bg-white text-brand-violet border border-line\"\n          >\n            <svg class=\"w-4 h-4 shrink-0\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n              <rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\" />\n              <circle cx=\"9\" cy=\"9\" r=\"2\" />\n              <path d=\"m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21\" />\n            </svg>\n            <span data-i18n=\"tabPhoto\">Photo</span>\n          </button>\n\n          <!-- 2. Reels -->\n          \n\n          <!-- 3. Video -->\n          <button\n            type=\"button\"\n            role=\"tab\"\n            id=\"tab-video\"\n            aria-selected=\"false\"\n            aria-controls=\"downloader-panel\"\n            data-tab=\"video\"\n            class=\"media-tab-btn min-h-[52px] sm:min-h-[48px] px-1.5 sm:px-3 py-2 rounded-xl flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 text-xs sm:text-sm font-medium cursor-pointer ui-transition text-ink-muted hover:text-ink border border-transparent\"\n          >\n            <svg class=\"w-4 h-4 shrink-0\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n              <polygon points=\"6 3 20 12 6 21 6 3\" />\n            </svg>\n            <span data-i18n=\"tabVideo\">Video</span>\n          </button>\n\n          <!-- 4. Audio -->\n          \n\n          <!-- 5. Profile -->\n          \n        </div>\n\n        <!-- MAIN DOWNLOADER PANEL -->\n        <div\n          id=\"downloader-panel\"\n          role=\"tabpanel\"\n          aria-labelledby=\"tab-photo\"\n          class=\"downloader-surface rounded-2xl border border-line overflow-hidden\"\n        >\n          <!-- Subtle 3px TikTok-inspired spectrum bar -->\n          <div class=\"h-1 w-full spectrum-bar\"></div>\n\n          <div class=\"p-4 sm:p-7\">\n            <!-- Panel Header Row -->\n            <div class=\"flex flex-wrap items-center justify-between gap-2 mb-4\">\n              <div>\n                <h2 id=\"panel-tool-title\" class=\"font-display font-bold text-lg sm:text-xl text-ink\">\n                  TikTok Photo &amp; Carousel Downloader\n                </h2>\n                <p id=\"panel-tool-subtitle\" class=\"text-xs sm:text-sm text-ink-muted mt-0.5\">\n                  Paste a public TikTok post link (`/@creator/photo/...`) to inspect resolution and save original images.\n                </p>\n              </div>\n              \n            </div>\n\n            <!-- Main URL Form -->\n            <form id=\"downloader-form\" novalidate class=\"space-y-3\">\n              <div class=\"flex flex-col sm:flex-row items-stretch gap-2.5\">\n                \n                <!-- Input + Inline Clear Button Container -->\n                <div class=\"relative flex-1 flex items-center min-w-0\">\n                  <label for=\"tiktok-url-input\" class=\"sr-only\">TikTok Post Link</label>\n                  <div class=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-muted pointer-events-none flex items-center\">\n                    <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\" />\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\" />\n                    </svg>\n                  </div>\n                  <input\n                    type=\"url\"\n                    id=\"tiktok-url-input\"\n                    name=\"tiktokUrl\"\n                    autocomplete=\"off\"\n                    spellcheck=\"false\"\n                    placeholder=\"Paste an TikTok photo or carousel link\"\n                    class=\"w-full min-h-[52px] pl-10 pr-28 sm:pr-36 py-3 rounded-xl bg-white border border-line-strong text-ink placeholder:text-ink-muted/75 text-sm sm:text-base focus:border-brand-violet ui-transition\"\n                    style=\"padding-left: 2.65rem; padding-right: 8.75rem;\"\n                  />\n\n                  <!-- Inline Paste + Clear Controls inside Input Right Edge -->\n                  <div class=\"absolute right-1.5 top-1/2 -translate-y-1/2 flex items-center gap-1\">\n                    <button\n                      type=\"button\"\n                      id=\"clear-url-btn\"\n                      title=\"Clear input\"\n                      aria-label=\"Clear link input\"\n                      class=\"hidden min-h-[40px] px-2.5 py-1.5 rounded-lg text-xs font-medium text-ink-muted hover:text-ink hover:bg-soft cursor-pointer ui-transition items-center gap-1\"\n                    >\n                      <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18 18 6M6 6l12 12\" />\n                      </svg>\n                      <span>Clear</span>\n                    </button>\n                    <button\n                      type=\"button\"\n                      id=\"paste-url-btn\"\n                      title=\"Paste link from clipboard\"\n                      aria-label=\"Paste link from clipboard\"\n                      class=\"min-h-[40px] px-3 py-1.5 rounded-lg bg-soft hover:bg-brand-violetSoft text-ink hover:text-brand-violet border border-line text-xs sm:text-sm font-medium flex items-center gap-1.5 cursor-pointer ui-transition\"\n                    >\n                      <svg class=\"w-3.5 h-3.5 text-brand-violet shrink-0\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n                        <rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\" />\n                        <path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\" />\n                      </svg>\n                      <span data-i18n=\"btnPaste\">Paste</span>\n                    </button>\n                  </div>\n                </div>\n\n                <!-- Primary Action CTA Button -->\n                <button\n                  type=\"submit\"\n                  id=\"submit-download-btn\"\n                  class=\"min-h-[52px] px-6 py-3 rounded-xl bg-brand-violet hover:bg-brand-violetHover active:scale-[0.99] text-white font-display font-semibold text-sm sm:text-base flex items-center justify-center gap-2 cursor-pointer ui-transition shrink-0\"\n                >\n                  <svg class=\"w-4 h-4 shrink-0\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" />\n                    <polyline points=\"7 10 12 15 17 10\" />\n                    <line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\" />\n                  </svg>\n                  <span id=\"submit-btn-label\">Download Photo</span>\n                </button>\n              </div>\n\n              <!-- Helpful Validation / Status Feedback Banner -->\n              <div id=\"validation-feedback\" role=\"status\" aria-live=\"polite\" class=\"hidden rounded-xl border px-3.5 py-2.5 text-xs sm:text-sm flex items-start justify-between gap-3\">\n                <div class=\"flex items-start gap-2.5\">\n                  <svg id=\"validation-icon\" class=\"w-4 h-4 shrink-0 mt-0.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\">\n                    <circle cx=\"12\" cy=\"12\" r=\"10\" />\n                    <line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" />\n                    <line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" />\n                  </svg>\n                  <span id=\"validation-message\">Please enter a valid TikTok link.</span>\n                </div>\n                <button type=\"button\" id=\"validation-action-btn\" class=\"hidden text-xs font-semibold underline shrink-0 cursor-pointer\"></button>\n              </div>\n\n              </form>\n\n            <!-- LOADING STATE PANEL -->\n            <div id=\"loading-state-panel\" class=\"hidden\" aria-live=\"polite\" aria-atomic=\"true\">\n              <div class=\"media-loading-card\">\n                <div class=\"media-loading-content\">\n                  <div class=\"media-loading-icon\">\n                    <svg class=\"w-5 h-5 animate-spin\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" aria-hidden=\"true\">\n                      <path d=\"M21 12a9 9 0 1 1-6.219-8.56\" stroke-linecap=\"round\" />\n                    </svg>\n                  </div>\n                  <div class=\"media-loading-copy\">\n                    <p class=\"text-sm font-semibold text-ink\" id=\"loading-step-title\">Finding your TikTok media\u2026</p>\n                    <p class=\"text-xs text-ink-muted mt-0.5 tabular-nums\" id=\"loading-step-detail\">Fetching available media and formats\u2026</p>\n                  </div>\n                </div>\n                <button\n                  type=\"button\"\n                  id=\"cancel-loading-btn\"\n                  class=\"media-loading-cancel\"\n                >\n                  Cancel\n                </button>\n              </div>\n            </div>\n\n            <!-- DOWNLOAD RESULT SECTION (DYNAMICALLY POPULATED) -->\n            <div id=\"result-section-wrap\" class=\"hidden mt-5 pt-5 border-t border-line\">\n              \n              <!-- Dynamic Result Container -->\n              <div id=\"result-dynamic-content\">\n                <!-- Populated by JS on load and on every tab/state/submit change -->\n              </div>\n\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- HOW TO USE SECTION (3 Simple Steps in a Semantic <ol> Ledger) -->\n    <section id=\"how-to-use\" class=\"py-12 sm:py-16 bg-soft border-y border-line px-4 sm:px-6\">\n      <div class=\"max-w-[1120px] mx-auto\">\n        <div class=\"max-w-[620px] mb-8 sm:mb-10\">\n          <h2 class=\"font-display font-bold text-2xl sm:text-3xl text-ink leading-tight\" data-i18n=\"howToTitle\">\n            Save Supported Media in Three Steps\n          </h2>\n          <p class=\"mt-2 text-sm sm:text-base text-ink-muted leading-relaxed\">\n            No account sign-in or browser extension required. Copy any public link from the TikTok app or web browser.\n          </p>\n        </div>\n\n        <ol class=\"grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 list-none p-0 m-0\">\n          <!-- Step 1 -->\n          <li class=\"bg-white border border-line rounded-2xl p-5 sm:p-6 flex flex-col justify-between\">\n            <div>\n              <div class=\"flex items-center justify-between gap-3 mb-4\">\n                <span class=\"inline-flex items-center px-2.5 py-1 rounded-md bg-brand-violetSoft text-brand-violet text-xs font-semibold\">\n                  First Step\n                </span>\n                <span class=\"text-xs text-ink-muted font-medium\">TikTok App or Web</span>\n              </div>\n              <h3 class=\"font-display font-bold text-lg text-ink mb-2\" data-i18n=\"step1Title\">\n                Copy the TikTok link\n              </h3>\n              <p class=\"text-sm text-ink-muted leading-relaxed mb-5\">\n                Open the public video or photo post on TikTok, tap the share or three-dot menu, and select <strong>Copy link</strong>.\n              </p>\n            </div>\n            <!-- Crisp Architectural Schematic SVG -->\n            <div class=\"p-3.5 rounded-xl bg-soft border border-line flex items-center justify-between gap-3\">\n              <div class=\"flex items-center gap-2.5 min-w-0\">\n                <span class=\"w-8 h-8 rounded-lg bg-white border border-line flex items-center justify-center text-brand-violet shrink-0\">\n                  <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71\"/><path d=\"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71\"/></svg>\n                </span>\n                <span class=\"text-xs text-ink-secondary truncate tabular-nums\">tiktok.com/@creator/video/\u2026</span>\n              </div>\n              <span class=\"px-2 py-1 rounded bg-white border border-line text-[11px] font-semibold text-brand-violet shrink-0\">Copied</span>\n            </div>\n          </li>\n\n          <!-- Step 2 -->\n          <li class=\"bg-white border border-line rounded-2xl p-5 sm:p-6 flex flex-col justify-between\">\n            <div>\n              <div class=\"flex items-center justify-between gap-3 mb-4\">\n                <span class=\"inline-flex items-center px-2.5 py-1 rounded-md bg-brand-pinkSoft text-brand-pink text-xs font-semibold step-label\">\n                  Second Step\n                </span>\n                <span class=\"text-xs text-ink-muted font-medium\">Auto-detects format</span>\n              </div>\n              <h3 class=\"font-display font-bold text-lg text-ink mb-2\" data-i18n=\"step2Title\">\n                Paste the link into the downloader\n              </h3>\n              <p class=\"text-sm text-ink-muted leading-relaxed mb-5\">\n                Tap the <strong>Paste</strong> button in the input bar above. TikSaveMP4 validates the shortcode and selects the matching tool tab automatically.\n              </p>\n            </div>\n            <!-- Crisp Architectural Schematic SVG -->\n            <div class=\"p-3.5 rounded-xl bg-soft border border-line flex items-center justify-between gap-2\">\n              <span class=\"text-xs font-medium text-ink-secondary truncate\">Post ID: <strong class=\"text-ink tabular-nums\">7170520270497680683</strong></span>\n              <span class=\"inline-flex items-center gap-1 px-2.5 py-1 rounded bg-brand-violet text-white text-[11px] font-semibold shrink-0\">\n                Paste &amp; Inspect\n              </span>\n            </div>\n          </li>\n\n          <!-- Step 3 -->\n          <li class=\"bg-white border border-line rounded-2xl p-5 sm:p-6 flex flex-col justify-between\">\n            <div>\n              <div class=\"flex items-center justify-between gap-3 mb-4\">\n                <span class=\"inline-flex items-center px-2.5 py-1 rounded-md bg-brand-orangeSoft text-brand-orange text-xs font-semibold step-label\">\n                  Third Step\n                </span>\n                <span class=\"text-xs text-ink-muted font-medium\">MP4 / JPEG Inspection</span>\n              </div>\n              <h3 class=\"font-display font-bold text-lg text-ink mb-2\" data-i18n=\"step3Title\">\n                Preview or download supported media\n              </h3>\n              <p class=\"text-sm text-ink-muted leading-relaxed mb-5\">\n                Review the media thumbnail, carousel slides, and available stream resolution before saving the file to your device.\n              </p>\n            </div>\n            <!-- Crisp Architectural Schematic SVG -->\n            <div class=\"p-3.5 rounded-xl bg-soft border border-line flex items-center justify-between gap-2\">\n              <div class=\"flex items-center gap-2\">\n                <span class=\"px-2 py-0.5 rounded bg-white border border-line text-[11px] font-semibold text-ink tabular-nums\">1080\u00d71920</span>\n                <span class=\"text-xs text-ink-muted tabular-nums\">MP4 \u00b7 H.264</span>\n              </div>\n              <span class=\"text-xs font-semibold text-emerald-700\">Ready \u2193</span>\n            </div>\n          </li>\n        </ol>\n      </div>\n    </section>\n\n    <!-- FEATURES & CAPABILITY MATRIX SECTION (Factual Claims Only) -->\n    <section id=\"features-section\" class=\"py-12 sm:py-16 px-4 sm:px-6 bg-white\">\n      <div class=\"max-w-[1120px] mx-auto\">\n        <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start\">\n          \n          <!-- Left Column: Factual Utility Summary -->\n          <div class=\"lg:col-span-5\">\n            <h2 class=\"font-display font-bold text-2xl sm:text-3xl text-ink leading-tight\">\n              Built for Fast, Transparent Media Inspection\n            </h2>\n            <p class=\"mt-3 text-sm sm:text-base text-ink-muted leading-relaxed\">\n              TikSaveMP4 focuses on clean usability and honest technical boundaries. Every feature is designed so ordinary users and creators can inspect public links without pop-ups or account walls.\n            </p>\n\n            <dl class=\"mt-6 space-y-4 border-t border-line pt-5\">\n              <div class=\"feature-definition\"><dt class=\"text-sm font-semibold text-ink\"><span class=\"w-6 h-6 rounded-md bg-brand-violetSoft text-brand-violet flex items-center justify-center shrink-0 mt-0.5\">\n                  <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n                </span>Simple interface</dt>\n                  <dd class=\"text-xs sm:text-sm text-ink-muted mt-0.5\">O