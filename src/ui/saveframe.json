hrink-0 ui-transition\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m6 9 6 6 6-6\"/></svg>\n              </button>\n            </h3>\n            <div id=\"faq-panel-4\" role=\"region\" aria-labelledby=\"faq-btn-4\" class=\"hidden px-5 pb-4 text-xs sm:text-sm text-ink-muted leading-relaxed border-t border-line/60 pt-3\">\n              No account registration or software installation is required. The interface runs in mobile Safari, Chrome, Firefox, and desktop browsers.\n            </div>\n          </div>\n\n          <!-- FAQ 5 -->\n          <div class=\"bg-white border border-line rounded-xl overflow-hidden\">\n            <h3>\n              <button\n                type=\"button\"\n                aria-expanded=\"false\"\n                aria-controls=\"faq-panel-5\"\n                id=\"faq-btn-5\"\n                class=\"faq-toggle-btn w-full min-h-[54px] px-5 py-4 text-left flex items-center justify-between gap-4 font-display font-semibold text-sm sm:text-base text-ink hover:bg-soft/50 cursor-pointer ui-transition\"\n              >\n                <span>Why can\u2019t my TikTok link be downloaded?</span>\n                <svg class=\"faq-chevron w-4 h-4 text-ink-muted shrink-0 ui-transition\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m6 9 6 6 6-6\"/></svg>\n              </button>\n            </h3>\n            <div id=\"faq-panel-5\" role=\"region\" aria-labelledby=\"faq-btn-5\" class=\"hidden px-5 pb-4 text-xs sm:text-sm text-ink-muted leading-relaxed border-t border-line/60 pt-3\">\n              Make sure the link points to a public post that is still available. Private, expired, deleted, or login-restricted media may not be accessible. If TikTok temporarily limits requests, wait a little and try again.\n        