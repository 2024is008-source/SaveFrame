# Set to the real public origin before your production build.
# Without it, metadata uses localhost and indexing is disabled.
NEXT_PUBLIC_SITE_URL=https://saveframe.site
# GA4 is production-only and follows the regional policy and visitor preferences.
NEXT_PUBLIC_GA_ID=G-0EYTT0CW4Z
# Override to 0 in staging/test deployments, even with a production build.
GA4_ENABLED=0
# Server policy; enable header trust only with the reviewed proxy configuration.
GA4_TRUST_REGION_HEADER=0
# Approved ISO country codes, comma-separated, or * for all except consent regions.
GA4_AUTOMATIC_COUNTRIES=
# Extra consent-required countries, or * when consent is required everywhere.
GA4_CONSENT_REQUIRED_COUNTRIES=
# Only reviewed, non-personal campaign labels are forwarded from URL parameters.
GA4_CAMPAIGN_SOURCES=
GA4_CAMPAIGN_MEDIUMS=
GA4_CAMPAIGN_NAMES=
GA4_CAMPAIGN_CONTENT=
GA4_CAMPAIGN_TERMS=
# Optional verified public contact addresses. Leave empty until confirmed.
SAVEFRAME_SUPPORT_EMAIL=backbencherz@gmail.com
SAVEFRAME_COPYRIGHT_EMAIL=backbencherz@gmail.com

# Admin: use a private, persistent local disk directory outside public/.
# Requires Node.js 24+. No admin account is created automatically.
# SAVEFRAME_ADMIN_DATA_DIR=/var/lib/saveframe
ADMIN_ORIGIN=https://saveframe.site
# Optional: a stable random secret of at least 32 characters, supplied by your host.
# Otherwise a private session.key is generated in SAVEFRAME_ADMIN_DATA_DIR.
# SAVEFRAME_ADMIN_SECRET=
# The only allowed admin login email (server-side; never NEXT_PUBLIC).
# SAVEFRAME_ADMIN_EMAIL=your-owner-address@gmail.com
# Required email OTP delivery. Gmail uses a Google App Password, never your main password.
ADMIN_SMTP_HOST=smtp.gmail.com
ADMIN_SMTP_PORT=587
# ADMIN_SMTP_USER=your-owner-address@gmail.com
# ADMIN_MAIL_FROM=your-owner-address@gmail.com
# ADMIN_SMTP_PASSWORD=
# Local production preview only; never enable this on your public deployment.
# ADMIN_ALLOW_LOCAL_HTTP=1

# Media worker controls (single persistent Node process).
# MAX_CONCURRENT_DOWNLOADS=2
# MAX_QUEUED_DOWNLOADS=20
# MAX_FILE_SIZE_BYTES=157286400
# FILE_RETENTION_MS=900000
# MIN_FREE_DISK_BYTES=104857600
# DOWNLOAD_TEMP_DIR=/var/lib/saveframe/downloads
