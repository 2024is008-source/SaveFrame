    "test:runtime": "node scripts/check-runtime.cjs",
    "test:styles": "node scripts/check-styles.cjs",
    "test:performance": "node scripts/check-performance.cjs",
    "test:preview": "node scripts/check-preview.cjs",
    "test:downloader": "node scripts/check-downloader.cjs",
    "test:stories": "node scripts/check-stories.cjs && node scripts/check-hybrid-stories.cjs",
    "story:authorized": "node scripts/story-authorized.cjs",
    "test:blog": "node scripts/check-blog.cjs",
    "test:i18n": "node scripts/check-i18n.cjs",
    "test:seo": "node scripts/check-seo.cjs",
    "admin:setup": "node scripts/admin.cjs create",
    "admin:migrate": "node scripts/admin.cjs migrate",
    "admin:cleanup": "node scripts/admin.cjs cleanup",
