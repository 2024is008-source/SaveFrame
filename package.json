    "test:admin:live": "node scripts/check-admin-live.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@next/third-parties": "^15.5.28",
    "@node-rs/argon2": "^2.2.2",
    "lucide-react": "^0.454.0",
