{
  "name": "saveframe-instagram-downloader",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-performance-assets.cjs",
    "prebuild": "node scripts/prepare-performance-assets.cjs",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/sanitize-build-traces.cjs",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint src next.config.ts",
    "test": "npm run test:site && npm run test:retired-media && npm run test:admin && npm run test:security && npm run test:preview && npm run test:downloader && npm run test:i18n && npm run test:blog && npm run test:analytics && npm run test:sitelinks && npm run test:audio",
    "test:site": "node scripts/check-site-config.cjs",
    "test:sitelinks": "node scripts/check-sitelinks.cjs",
    "test:audio": "node scripts/check-audio.cjs",
    "test:audio:browser": "node scripts/check-audio-browser.cjs",
    "test:sitelinks:browser": "node scripts/check-sitelinks-browser.cjs",
    "test:analytics": "node scripts/check-analytics.cjs && node scripts/check-download-analytics.cjs && node scripts/check-operational-analytics.cjs",
    "test:security": "node scripts/check-security.cjs && node scripts/check-audit-regressions.cjs",
    "test:runtime": "node scripts/check-runtime.cjs",
    "test:styles": "node scripts/check-styles.cjs",
    "test:performance": "node scripts/check-performance.cjs",
    "benchmark:resolution": "node scripts/benchmark-resolution.cjs",
    "test:preview": "node scripts/check-preview.cjs && node scripts/check-paste-flow.cjs",
    "test:downloader": "node scripts/check-downloader.cjs && node scripts/check-resolution-performance.cjs",
    "test:instagrapi": "node scripts/check-instagrapi.cjs",
    "test:blog": "node scripts/check-blog.cjs",
    "test:i18n": "node scripts/check-i18n.cjs",
    "test:seo": "node scripts/check-seo.cjs",
    "admin:setup": "node scripts/admin.cjs create",
    "admin:migrate": "node scripts/admin.cjs migrate",
    "admin:cleanup": "node scripts/admin.cjs cleanup",
    "test:admin": "node scripts/check-admin.cjs && node scripts/check-api-error-reporting.cjs && node scripts/check-country-analytics.cjs",
    "test:countries": "node scripts/check-country-analytics.cjs",
    "test:admin:live": "node scripts/check-admin-live.cjs",
    "typecheck": "tsc --noEmit",
    "test:retired-media": "node scripts/check-retired-media.cjs"
  },
  "dependencies": {
    "@next/third-parties": "^15.5.28",
    "@node-rs/argon2": "^2.2.2",
    "lucide-react": "^0.454.0",
    "next": "^15.0.0",
    "nodemailer": "^10.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
